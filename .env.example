# Every value here is optional. The website works without any of them,
# and the order still reaches the shop through WhatsApp.

# Push every order to the shop WhatsApp automatically (callmebot.com).
# Send "I allow callmebot to send me messages" to +34 644 51 95 23 to get the key.
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=

# Order emails, option one: Resend (resend.com, free account)
RESEND_API_KEY=

# Order emails, option two: any mailbox over SMTP, a Gmail app password included
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Sender and destination for the order emails.
# Leave ORDER_EMAIL_TO empty to use the list in lib/brand.ts, which sends every
# order to rootsrevivalpakistan@gmail.com and ainaabidi25@gmail.com. To override
# it, separate the addresses with commas.
#
# Note on Resend: the shared onboarding@resend.dev sender only delivers to the
# address the Resend account was created with. To reach both inboxes, verify a
# domain in Resend and put an address on that domain in ORDER_EMAIL_FROM, or use
# the SMTP option above, which reaches both today.
ORDER_EMAIL_FROM="Roots Revival <onboarding@resend.dev>"
ORDER_EMAIL_TO=

# Optional: post the order to any webhook (Zapier, Make, Slack, Discord)
ORDER_WEBHOOK_URL=
