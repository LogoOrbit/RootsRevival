# Every value here is optional. The website works without any of them.

# Order emails through Resend (recommended). Sign up at resend.com with the shop email.
RESEND_API_KEY=
ORDER_EMAIL_FROM="Roots Revival <onboarding@resend.dev>"

# Where orders and website messages are emailed.
# Leave empty to use the address in lib/brand.ts
ORDER_EMAIL_TO=

# Optional: let the server push each order to WhatsApp on its own (callmebot.com)
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=
